# Copy to .env and fill in. Never commit .env.
#
# Everything runs offline with the defaults below — the fake providers are
# fully functional, not stubs. Real keys drop in with zero code change.

# ── Providers ───────────────────────────────────────────────────
# fake | resend
EMAIL_PROVIDER=fake
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# fake | anthropic | openai | openrouter
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenRouter: one key routes to 100+ models (openrouter.ai/keys). Model
# names are vendor-qualified, e.g. "anthropic/claude-sonnet-4.5",
# "openai/gpt-4o", "meta-llama/llama-3.1-70b-instruct" — pick one when
# calling get_llm_provider(), not here.
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=

# Signs webhooks emitted by FakeEmailProvider back to our own endpoint.
FAKE_WEBHOOK_SECRET=fake-webhook-secret

# ── ML (Phase 6 bounce-risk model) ─────────────────────────────
# Off by default — preflight works without it, using a stated neutral
# delivery estimate instead. Enable once you've trained + registered a model
# (see ml/training/train_bounce_model.py and ml/registry/promote.py).
BOUNCE_MODEL_ENABLED=false
MLFLOW_TRACKING_URI=sqlite:///ml/mlflow.db

# ── Sending ─────────────────────────────────────────────────────
FROM_ADDRESS=hello@sendrun.test
FROM_NAME=Sendrun
# Keep below the provider's real limit; the token bucket throttles to this.
SEND_RATE_PER_SECOND=8

# ── Datastores ──────────────────────────────────────────────────
# Neon (free tier). SQLite is fine for local dev.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# Upstash (free tier). Optional locally — falls back to in-memory.
REDIS_URL=

# Cloudflare R2 (free tier), for attachments.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sendrun-attachments

# ── Worker ──────────────────────────────────────────────────────
WORKER_ID=worker_local
LEASE_SECONDS=30
POLL_INTERVAL_SECONDS=1
MAX_ATTEMPTS=5

# ── Chaos (dev only) ────────────────────────────────────────────
# Seeded per idempotency key, so a given run is reproducible.
CHAOS_ENABLED=false
CHAOS_SEED=42

# ── App ─────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production
# Set true in any real deployment (Vercel/Render both terminate TLS in front
# of the app). Leave false for local http://localhost dev — a Secure cookie
# is never sent over plain HTTP, so true here would break sign-in locally.
COOKIE_SECURE=false
# Leave empty for the frontend to use its mock data layer.
NEXT_PUBLIC_API_URL=
