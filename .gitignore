# ═══════════════════════════════════════════════════════════════
# Sendrun
# ═══════════════════════════════════════════════════════════════

# ── Secrets — never commit ──────────────────────────────────────
# The .env.example template IS committed; real values never are.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json
secrets/

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── Node / Next.js ──────────────────────────────────────────────
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Regenerated by `next dev` on every run (verified: the generator ships at
# next/dist/server/lib/generate-agent-files.js). Tool output, not source.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# ── Local data ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
local.db
dump.rdb

# ── ML / MLOps ──────────────────────────────────────────────────
mlruns/
mlartifacts/
ml/mlflow.db
*.pkl
*.joblib
*.onnx
*.pt
*.ckpt
*.skops
# Generated data/reports/figures — regenerate via ml/data/generate_synthetic.py,
# ml/data/eda.py, ml/evaluation/evaluate.py. Not source; large and reproducible.
# (File-pattern rules, not a directory rule: git cannot re-include files with
# a `!` negation inside a directory that was itself ignored wholesale.)
ml/data/*.parquet
ml/data/*.csv
ml/data/eda_report.txt
ml/data/eda_figures/
ml/evaluation/figures/

# ── dbt ─────────────────────────────────────────────────────────
analytics/dbt/target/
analytics/dbt/dbt_packages/
analytics/dbt/logs/
.user.yml

# ── Deploy / infra ──────────────────────────────────────────────
.vercel/
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# ── Test artifacts ──────────────────────────────────────────────
playwright-report/
test-results/
blob-report/
.playwright/

# ── OS / editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ── Scratch ─────────────────────────────────────────────────────
tmp/
scratch/
*.log

# ── Design source archive ───────────────────────────────────────
# The VibeCurb skills are installed in .claude/skills/; the zip itself
# does not belong in the repo.
design-sources.zip

# ── Claude Code / agent working files ────────────────────────────
# Kept LOCAL rather than pushed to GitHub, at the user's request. If files
# under these paths are already tracked from an earlier commit, adding them
# here does not untrack them — see the `git rm -r --cached` step in the
# commit instructions.
.claude/
CLAUDE.md
PLAN.md
NEXT.md
